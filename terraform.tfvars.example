# Example Terraform variables file
# Copy this file to terraform.tfvars and update the values

# Azure Subscription Configuration (Required in Provider 4.0+)
subscription_id = "00000000-1234-5678-9abc-123456789012"

# Basic Configuration
resource_group_name = "rg-ml-a10v5-prod"
location           = "East US"
prefix             = "ml-prod"

# A10v5 VM Configuration
# Available sizes:
# - Standard_NV6ads_A10_v5  (6 vCPUs, 55 GiB RAM, 1/6 GPU)
# - Standard_NV12ads_A10_v5 (12 vCPUs, 110 GiB RAM, 1/3 GPU)
# - Standard_NV18ads_A10_v5 (18 vCPUs, 165 GiB RAM, 1/2 GPU)
# - Standard_NV36ads_A10_v5 (36 vCPUs, 330 GiB RAM, 1 GPU)
# - Standard_NV72ads_A10_v5 (72 vCPUs, 660 GiB RAM, 2 GPUs)
a10v5_vm_size = "Standard_NV36ads_A10_v5"

# SSH Public Key for compute instance access
# Generate with: ssh-keygen -t rsa -b 4096 -C "your_email@example.com"
ssh_public_key = "ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAACAQDExample... your-email@example.com"

# Resource Tags
tags = {
  Environment = "Production"
  Project     = "ML-A10v5-Healthcare"
  Owner       = "ML-Team"
  CostCenter  = "Engineering"
  UseCase     = "Healthcare-AI"
}

# Healthcare AI Configuration
healthcare_agents_enabled = true
cxr_model_name = "microsoft-cxrreportgen"
medparse_model_name = "microsoft-medimageparse"
medinsight_model_name = "microsoft-medimageinsight"
healthcare_agent_instance_type = "Standard_NC6s_v3"
